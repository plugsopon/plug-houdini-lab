// Stem guide curve (AI-drawn approximation; tutorial draws it by hand at 15:34). Bottom (0,0,0) -> flower end.
int N=6; int pr=addprim(0,"polyline");
vector pts[] = {{0,0,0},{0.05,0.5,0.02},{0.22,1.0,0.0},{0.35,1.55,-0.06},{0.30,2.1,-0.02},{0.12,2.6,0.03},{0.0,3.0,0.0}};
foreach(vector p; pts){ int pt=addpoint(0,p); addvertex(0,pr,pt);}
